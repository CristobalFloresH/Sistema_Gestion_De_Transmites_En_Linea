      "name": "Trámites - Registro por administrador",
      "scope": "collection",
      "description": "Alta de usuarios solo para el administrador y login con tipo de acceso (ciudadano o funcionario). Ejecutar en orden con la base recién cargada. Las peticiones con token lo toman de la respuesta del login indicado (Auth → Bearer Token)."
    },
    {
      "_id": "req_reg_00_login_admin",
      "_type": "request",
      "parentId": "wrk_registro_admin",
      "name": "00 Login administrador por acceso funcionario (200)",
      "method": "POST",
      "url": "http://localhost:3000/api/auth/login",
      "metaSortKey": 0,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"rut\": \"11111111-1\",\n  \"password\": \"Clave123!\",\n  \"acceso\": \"funcionario\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
