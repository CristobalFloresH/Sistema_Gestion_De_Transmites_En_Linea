      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"rut\": \"16666666-K\",\n  \"nombre\": \"Ciudadano Nuevo\",\n  \"correo\": \"ciudadano.nuevo@prueba.cl\",\n  \"telefono\": \"+56922222222\",\n  \"password\": \"Segura#2026\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {
        "type": "bearer",
        "token": "{% response 'body', 'req_reg_00_login_admin', 'b64::JC50b2tlbg==::46b', 'no-history', 60 %}"
