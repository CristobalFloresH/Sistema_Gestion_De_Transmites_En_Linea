# Copiar este archivo como .env y completar los valores antes de docker compose up

# Contraseña del usuario postgres de la base que crea Docker (se elige al crear la base por primera vez)
DB_PASSWORD=

# Clave para firmar los JWT. Usar un texto largo y aleatorio
JWT_SECRET=
JWT_EXPIRES_IN=2h

# WhatsApp. Sin token ni número el envío queda desactivado y el sistema sigue funcionando
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PLANTILLA_CONFIRMACION=confirmacion_cita
WHATSAPP_PLANTILLA_IDIOMA=es
WHATSAPP_PLANTILLA_LISTA=licencia_lista
WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio_cita

# Correo. Cuenta de Gmail con verificacion en dos pasos y una "contrasena de aplicacion".
# Sin usuario y clave el envio queda desactivado y el sistema sigue funcionando
CORREO_USUARIO=licencias.santodomingo@gmail.com
CORREO_CLAVE=
CORREO_REMITENTE=Municipalidad de Santo Domingo
